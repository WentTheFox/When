APP_NAME=When
APP_ENV=local
APP_KEY=base64:iYizDrPqMTfHX8YUzs8tjYBOXr0+4CYc7AsGbsU4Nig=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Reuses the same disposable DB phpunit's own Feature/Unit tests already
# use (.env.testing) — never the real dev DB (whenthefox, see .env). Dusk
# boots a real PHP webserver process serving actual HTTP requests, so it
# can't share a transaction-rolled-back DB with the test runner the way
# Feature tests do; DatabaseMigrations resets this schema fresh before
# each Dusk test instead (safe here since it's already a scratch DB).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=whenthefox_test
DB_USERNAME=postgres
DB_PASSWORD=

# file, not array — Dusk's PHP dev server forks a fresh process per HTTP
# request, so an in-memory (array) session/cache store would vanish
# between requests (e.g. the session loginAs() sets on its own request
# would already be gone by the time the browser's next navigation hits a
# new process). .env.testing can get away with `array` because phpunit's
# Feature tests stay in a single process for the whole test.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=array
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

DUSK_CHROME_BINARY=/usr/bin/chromium
