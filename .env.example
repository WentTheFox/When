# ── Secret tiers (see PLAN.md §0) ───────────────────────────────────────────
# Every secret below is annotated with which threat-model tier it belongs to:
#
#   [runtime-only]           Must live only in the server's runtime secrets
#                             (env var / secrets manager). Never committed,
#                             never stored in the database. Losing this file
#                             or rotating it without a migration plan can make
#                             existing ciphertext unrecoverable.
#
#   [safe-to-commit-example] Fine to have a placeholder/example value
#                             committed here; the real value is still a
#                             per-environment secret, just not a cryptographic
#                             key that gates decryption of stored data.
#
# Connections CRM data (§0.1) never touches server-held keys at all — it's
# encrypted client-side with a vault key derived from the owner's passphrase,
# which this app's config never sees.

# App/repo/GitHub name is all just "When" now. The production directory,
# Postgres database, and DB role below still use the old "whenthefox" name
# (deliberately not renamed — see CLAUDE.md) but that's an internal-only
# detail no visitor ever sees.
APP_NAME=When
APP_ENV=local
# [runtime-only] Standard Laravel app key. Also doubles as the key behind the
# Crypt facade, which is what encrypts/decrypts calendar_url (§0.2)
# transiently, in-memory, inside the ICS-fetch job only.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Independent of LOG_LEVEL on purpose — see config/logging.php's
# "availability" channel doc comment. Turning LOG_LEVEL down in production
# must not also silence the availability-pipeline timing traces.
LOG_AVAILABILITY_LEVEL=info

# Postgres, for parity with the source app's proven-out bytea/uuid usage.
# Use a role scoped to just this database (owns whenthefox, not a cluster
# superuser) — e.g. `CREATE ROLE whenthefox_app LOGIN PASSWORD '...';
# ALTER DATABASE whenthefox OWNER TO whenthefox_app;`.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=whenthefox
# [safe-to-commit-example] Per-environment credential, not a decryption key.
DB_USERNAME=whenthefox_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Only needed if the app is served over https locally (e.g. via nginx) —
# points the Vite dev server at the same cert so its assets aren't blocked
# as mixed content / cross-origin. Leave blank to run the dev server over
# plain http.
VITE_DEV_SERVER_KEY=
VITE_DEV_SERVER_CERT=
