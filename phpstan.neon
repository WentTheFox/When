includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/spaze/phpstan-disallowed-calls/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 2
    paths:
        - app
        - database
        - routes

    # Every timestamp column must be timestamptz: Laravel writes zone-less
    # strings in UTC and config/database.php pins the DB session to UTC, so a
    # zone-less column would silently lose its meaning the moment either side
    # changes. Use the *Tz variants. Migrations written before this rule are
    # grandfathered in phpstan-baseline.neon (production was converted by
    # 2026_11_05_080000_convert_timestamps_to_timestamptz).
    disallowedMethodCalls:
        -
            method: 'Illuminate\Database\Schema\Blueprint::timestamp()'
            message: 'use timestampTz()'
        -
            method: 'Illuminate\Database\Schema\Blueprint::timestamps()'
            message: 'use timestampsTz()'
        -
            method: 'Illuminate\Database\Schema\Blueprint::nullableTimestamps()'
            message: 'use timestampsTz() with nullable columns'
        -
            method: 'Illuminate\Database\Schema\Blueprint::softDeletes()'
            message: 'use softDeletesTz()'
        -
            method: 'Illuminate\Database\Schema\Blueprint::dateTime()'
            message: 'use dateTimeTz()'
