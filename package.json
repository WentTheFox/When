{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev:server": "infisical run --env=dev -- vite",
        "dev:php": "git-deploy-dev when-fpm",
        "dev:queue": "git-deploy-dev when-horizon",
        "dev": "concurrently -p name pnpm:dev:*",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "vue-tsc --noEmit"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "@types/qrcode": "^1.5.6",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/test-utils": "^2.5.1",
        "axios": "^1.19.0",
        "bootstrap": "^5.3.8",
        "concurrently": "^9.2.4",
        "happy-dom": "^21.0.4",
        "hash-wasm": "^4.12.0",
        "laravel-vite-plugin": "^2.1.0",
        "tsx": "^4.23.12",
        "typescript": "^6.0.3",
        "vite": "^7.3.6",
        "vitest": "^4.1.11",
        "vue-tsc": "^3.3.11"
    },
    "dependencies": {
        "@date-fns/tz": "^1.5.0",
        "@inertiajs/vue3": "^2.3.27",
        "@lucide/vue": "^1.61.0",
        "bootstrap-vue-next": "1.0.2",
        "date-fns": "^4.4.0",
        "flag-icons": "7.6.0",
        "laravel-vue-i18n": "^2.8.0",
        "qrcode": "^1.5.4",
        "regexpp": "^3.2.0",
        "vue": "^3.5.41",
        "vuedraggable": "^4.1.0"
    }
}
