[Unit]
Description=When php-fpm (local dev, secrets from Infisical)
After=network.target

[Service]
# No User=: git-deploy-run must start as root to read the root-only identity file
# (/etc/infisical/identities/when.env), then drops to went for php-fpm itself.
WorkingDirectory=/home/went/git/WentTheFox/When

# Runs as root before the drop, so the unprivileged master can create its pid file and socket.
ExecStartPre=/usr/bin/install -d -o went -g went -m 0750 /run/when-fpm
ExecStart=/usr/local/bin/git-deploy-run --user went when -- /usr/sbin/php-fpm8.5 -F -y /home/went/git/WentTheFox/When/setup/dev/php-fpm.conf
# Secrets are fetched once at start: after rotating one in Infisical, `systemctl restart` (a reload
# keeps the master's old environment).
ExecReload=/bin/kill -USR2 $MAINPID

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
